<?xml version="1.0" encoding="utf-8"?>
<!--
  The strings this fork adds for MASQUE. They live apart from strings.xml so
  that upstream's translation traffic, which rewrites that file wholesale,
  never collides with them.
-->
<resources>
    <string name="action_masque" translatable="false">MASQUE</string>
    <string name="masque_mode">Transport</string>
    <string name="masque_mode_quic" translatable="false">QUIC (HTTP/3)</string>
    <string name="masque_mode_http2" translatable="false">HTTP/2</string>
    <string name="masque_http2_address">HTTP/2 endpoint</string>
    <string name="masque_http2_address_sum">Endpoint used in HTTP/2 mode. Leave empty to use 162.159.198.2.</string>
    <string name="masque_local_address">Assigned addresses</string>
    <string name="masque_local_address_sum">Addresses assigned to this device inside the tunnel, one per line.</string>
    <string name="masque_private_key">Device private key</string>
    <string name="masque_endpoint_public_key">Endpoint public key</string>
    <string name="masque_endpoint_public_key_sum">PEM public key the endpoint is pinned to.</string>
    <string name="masque_keepalive_period">Keepalive period (s)</string>
    <string name="masque_initial_packet_size">Initial packet size</string>
    <string name="masque_initial_packet_size_sum">0 keeps path MTU discovery enabled.</string>
    <string name="masque_http2_ping_period">Liveness check (s)</string>
    <string name="masque_http2_ping_period_sum">Ping the connection once it has received nothing for this long, and drop it if the ping goes unanswered. 0 leaves it unchecked, which is fine on a direct path; set it when the tunnel runs through another proxy.</string>
</resources>
